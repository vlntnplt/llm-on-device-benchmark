{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/llm-on-device-benchmark/schema/results.schema.json",
  "title": "Aggregated results object",
  "description": "Written by the harness — one per backend. Per (model, quant, provider): the model geometry as the runtime reported it, aggregated sweep points, and the validation job's metrics. Per provider: device ceiling probes. Derived from the raw traces; `bench aggregate` re-derives it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "backend", "machine", "job_spawns", "probes", "runs"],
  "properties": {
    "schema_version": { "const": "3" },
    "backend": { "enum": ["ggml"] },
    "machine": {
      "type": "object",
      "required": ["host", "os", "cpu", "cpu_cores", "cpu_threads", "gpus", "memory"],
      "properties": {
        "host": { "type": "string", "description": "Machine name — hostname, or `bench run --machine`. The analysis loader's label when results aren't under a per-machine subdir." },
        "os": { "enum": ["linux", "macos", "windows"] },
        "cpu": { "type": "string" },
        "cpu_cores": { "type": "integer", "minimum": 1, "description": "Physical cores." },
        "cpu_threads": { "type": "integer", "minimum": 1, "description": "Logical cores (SMT)." },
        "gpus": { "type": "array", "items": { "type": "string" } },
        "memory": { "$ref": "#/$defs/memoryInfo" }
      }
    },
    "job_spawns": { "type": "integer", "minimum": 1, "description": "S: process re-spawns for the validation job (default 1). Sweep and probe points carry their own per-point n — repetition there is adaptive, in-process." },
    "probes": {
      "type": "array",
      "description": "Device ceilings, one entry per device lane that was probed.",
      "items": { "$ref": "#/$defs/probeResult" }
    },
    "runs": { "type": "array", "items": { "$ref": "#/$defs/run" } }
  },
  "$defs": {
    "stat": {
      "type": "array",
      "description": "[p50, max] — median is the estimate, max flags instability.",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "nullableStat": {
      "oneOf": [
        { "$ref": "#/$defs/stat" },
        { "type": "null", "description": "Not measurable here (e.g. *_vram on a CPU EP)." }
      ]
    },
    "memoryInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_gb", "channels", "configured_mts", "rated_mts", "rank", "dimms"],
      "description": "Installed memory as configured — the source of nominal bandwidth (channels × width × configured MT/s), never the CPU's spec-sheet maximum. Fields beyond total_gb are null when the platform tool (dmidecode / system_profiler) was unavailable.",
      "properties": {
        "total_gb": { "type": "number", "minimum": 0 },
        "channels": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }], "description": "Populated memory channels." },
        "configured_mts": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }], "description": "MT/s the memory actually runs at." },
        "rated_mts": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }], "description": "MT/s the DIMMs are rated for (differs from configured when a profile is off)." },
        "rank": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }], "description": "Ranks per DIMM (min across DIMMs when mixed)." },
        "dimms": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["size_gb", "configured_mts", "rated_mts", "rank"],
                "properties": {
                  "size_gb": { "type": "number", "minimum": 0 },
                  "configured_mts": { "oneOf": [{ "type": "integer" }, { "type": "null" }] },
                  "rated_mts": { "oneOf": [{ "type": "integer" }, { "type": "null" }] },
                  "rank": { "oneOf": [{ "type": "integer" }, { "type": "null" }] }
                }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "probeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "device", "status", "gemm", "copy"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*:[0-9]+$", "description": "Device lane: <family>:<index> (see events.schema.json)." },
        "device": { "type": "string" },
        "status": { "enum": ["ok", "errored"] },
        "gemm": {
          "type": "array",
          "description": "Per-point matmul throughput; the ceiling estimate is the best point.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["m", "n", "k", "dtype", "tflops_p50", "n_reps"],
            "properties": {
              "m": { "type": "integer" }, "n": { "type": "integer" }, "k": { "type": "integer" },
              "dtype": { "type": "string" },
              "tflops_p50": { "type": "number", "minimum": 0 },
              "n_reps": { "type": "integer", "minimum": 1, "description": "Repeats behind the median." }
            }
          }
        },
        "copy": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "bytes", "gbs_p50", "n_reps"],
            "properties": {
              "kind": { "enum": ["h2d", "d2h", "d2d"] },
              "bytes": { "type": "integer", "minimum": 1 },
              "gbs_p50": { "type": "number", "minimum": 0 },
              "n_reps": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "geometry": {
      "type": "object",
      "description": "The events geometry block, carried verbatim from the sweep (or job) spawn — see events.schema.json $defs.geometry for field semantics.",
      "required": ["n_layer", "n_embd", "n_head", "n_head_kv", "n_swa", "n_ctx_train", "n_params", "file_bytes", "context", "layers", "tensors", "buffers"]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "device", "model", "quant", "healthy", "vram_method", "geometry", "sweep", "job"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*:[0-9]+$", "description": "Device lane: <family>:<index> (see events.schema.json)." },
        "device": { "type": "string" },
        "model": { "type": "string" },
        "quant": { "enum": ["fp16", "q8", "q4", "q2"] },
        "healthy": { "type": "boolean", "description": "Brain-check passed for this (model, provider)." },
        "unhealthy_reason": { "type": "string", "description": "Present iff healthy=false: which brain-check failed and why; sweep and job were skipped." },
        "vram_method": { "enum": ["nvml", "drm", "unified", "n/a"], "description": "How per-PID VRAM was obtained: NVML, DRM fdinfo's device-local pool, unified memory, or unavailable." },
        "geometry": { "oneOf": [{ "$ref": "#/$defs/geometry" }, { "type": "null", "description": "No spawn got far enough to report it." }] },
        "sweep": { "$ref": "#/$defs/sweepResult" },
        "job": { "$ref": "#/$defs/jobResult" }
      }
    },
    "sweepResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "prefill", "decode"],
      "description": "Aggregated sweep points. Points may be present with a non-ok status: whatever completed before the failure is kept (a partial sweep still informs the fit).",
      "properties": {
        "status": { "enum": ["ok", "too_slow", "errored", "skipped"], "description": "skipped = gate failed, sweep never attempted. too_slow = the harness hang guard killed the spawn." },
        "prefill": {
          "type": "array",
          "description": "Chunk timings of the single instrumented pass — the marginal cost curve (ms vs the context the chunk was ingested at); TTFT at depth d is the cumulative sum through d. A short series is a small measured envelope (slow silicon under the sweep budget), not missing data.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["context", "tokens", "ms"],
            "properties": {
              "context": { "type": "integer", "minimum": 0, "description": "KV depth before this chunk." },
              "tokens": { "type": "integer", "minimum": 1, "description": "Chunk size (the deployment ubatch)." },
              "ms": { "type": "number", "minimum": 0 }
            }
          }
        },
        "decode": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kv_fill", "tokens", "tps_p50", "tps_min", "tps_max", "n_reps"],
            "properties": {
              "kv_fill": { "type": "integer", "minimum": 0 },
              "tokens": { "type": "integer", "minimum": 2 },
              "tps_p50": { "type": "number", "minimum": 0 },
              "tps_min": { "type": "number", "minimum": 0 },
              "tps_max": { "type": "number", "minimum": 0 },
              "n_reps": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "jobResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "task"],
      "description": "The validation job — a real end-to-end task whose measured cost checks what the sweeps predict. metrics/memory/sample_completions present iff status is ok.",
      "properties": {
        "status": { "enum": ["ok", "too_slow", "errored", "skipped"] },
        "task": { "type": "string" },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cold_start_ms", "model_load_ms", "context_init_ms", "warmup_ms", "ttft_ms", "decode_tps", "prefill_tps", "completion_ms"],
          "properties": {
            "cold_start_ms": { "$ref": "#/$defs/nullableStat", "description": "First-touch load (cold page cache): model-load + context-init, n=1." },
            "model_load_ms": { "$ref": "#/$defs/stat", "description": "Warm load phase — read/mmap weights and place on device." },
            "context_init_ms": { "$ref": "#/$defs/stat", "description": "Warm load phase — allocate KV cache / compute graph / context." },
            "warmup_ms": { "$ref": "#/$defs/stat", "description": "One-time kernel/JIT warm pass, once per process." },
            "ttft_ms": { "$ref": "#/$defs/stat" },
            "decode_tps": { "$ref": "#/$defs/stat" },
            "prefill_tps": { "$ref": "#/$defs/nullableStat" },
            "completion_ms": { "$ref": "#/$defs/stat" }
          }
        },
        "memory": {
          "type": "object",
          "description": "Per-phase footprint over the job iterations, sampled from outside. Decode gets peak (what must fit) and sustained (median — the steady working set); they diverge when a transient rides into the decode window.",
          "additionalProperties": false,
          "required": ["prefill_rss_peak_mb", "prefill_vram_peak_mb", "decode_rss_peak_mb", "decode_vram_peak_mb", "decode_rss_sustained_mb", "decode_vram_sustained_mb"],
          "properties": {
            "prefill_rss_peak_mb": { "$ref": "#/$defs/nullableStat" },
            "prefill_vram_peak_mb": { "$ref": "#/$defs/nullableStat" },
            "decode_rss_peak_mb": { "$ref": "#/$defs/nullableStat" },
            "decode_vram_peak_mb": { "$ref": "#/$defs/nullableStat" },
            "decode_rss_sustained_mb": { "$ref": "#/$defs/nullableStat" },
            "decode_vram_sustained_mb": { "$ref": "#/$defs/nullableStat" }
          }
        },
        "sample_completions": {
          "type": "array",
          "description": "A few decoded completions carried up from the events so a human can eyeball that the stack produced real text. Inspection aid only.",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    }
  }
}
