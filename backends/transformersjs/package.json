{
  "name": "bench-tjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Transformers.js backend for the on-device LLM inference benchmark (key: tjs).",
  "bin": {
    "bench-tjs": "dist/bench.js"
  },
  "scripts": {
    "build": "esbuild src/bench.js --bundle --platform=node --format=esm --target=node18 --outfile=dist/bench.js --banner:js=\"#!/usr/bin/env node\" --external:@huggingface/transformers --external:onnxruntime-node --external:sharp",
    "start": "node dist/bench.js",
    "format": "prettier --write src",
    "lint": "prettier --check src"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "onnxruntime-node": "1.24.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prettier": "^3.3"
  }
}
